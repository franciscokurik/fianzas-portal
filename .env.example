# Variables de entorno del Portal de Fianzas (Vercel + Neon Postgres)
# Copia a .env para desarrollo local, o configúralas en Vercel (Project Settings → Environment Variables).

# Cadena de conexión de Postgres (Neon / Vercel Postgres). Usa la versión "pooled".
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Secreto para firmar los JWT de sesión (cadena larga y aleatoria).
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# --- Almacenamiento de archivos: Cloudinary ---
# Cópiala del Dashboard de Cloudinary (Settings -> API Keys -> "API environment
# variable"), sin el prefijo "CLOUDINARY_URL=" que trae al copiar.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Alternativa por si la plataforma no acepta pegar la URL completa. Con
# CLOUDINARY_URL definida, estas tres se ignoran.
# CLOUDINARY_CLOUD_NAME=mi-cuenta
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) Carpeta raíz dentro de Cloudinary. Por omisión 'fortex-fianzas'.
# Útil para que un entorno de pruebas no revuelva sus archivos con producción.
# CLOUDINARY_FOLDER=fortex-fianzas-pruebas

# Token de Vercel Blob. Ya NO se usa para subir: solo hace falta si en la base
# quedan documentos de antes de migrar a Cloudinary y quieres que al
# reemplazarlos se borre también el archivo viejo.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Clave para proteger el endpoint /api/setup (crear esquema + sembrar demo).
SETUP_KEY=una-clave-secreta-para-setup

# (Opcional) Dominio obligatorio para las cuentas de Fortex (admin y vendedores).
# Por omisión 'fortex.mx'. A los usuarios de los fiados no se les exige dominio.
# DOMINIO_INTERNO=fortex.mx

# (Opcional) Envío de correos. Por defecto 'console' (solo imprime).
EMAIL_MODE=console
EMAIL_FROM=fianzas@fortex.mx
